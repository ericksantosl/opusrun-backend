generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id     Int    @id @default(autoincrement())
  titulo String
  status Int
  userId Int
  user   User   @relation(fields: [userId], references: [id])
}

model User {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String
  tasks Task[]
}
